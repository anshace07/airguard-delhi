# Copy this file to .env and fill in your own values. Never commit .env.
#   Mac / WSL:  cp .env.example .env

# OpenAQ API key (free): create an account at https://explore.openaq.org and copy the key from your account settings
OPENAQ_API_KEY=

# Optional second live source (data.gov.in CPCB feed)
DATA_GOV_IN_API_KEY=

# Kafka (defaults work with infra/docker-compose.yml)
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_TOPIC=aq_live

# Spark memory. 4g suits a 8-16 GB laptop; use 6g or 8g if you have 16 GB+ free
SPARK_DRIVER_MEMORY=4g

# Optional: keep the big data folder somewhere else (e.g. an external drive)
# AIRGUARD_DATA_DIR=/path/to/data
